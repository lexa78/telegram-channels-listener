{
    "require": {
      "danog/madelineproto": "^8.6",
      "vlucas/phpdotenv": "^5.6",
      "amphp/file": "^3.2",
      "php-amqplib/php-amqplib": "^3.7"
    },
    "autoload": {
      "psr-4": {
        "App\\": "app/"
      }
    },
    "config": {
      "optimize-autoloader": true,
      "preferred-install": "dist",
      "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
